#!/usr/bin/env python3
"""Fail-closed, read-only comparison of local policy and GitHub rollout state."""
from __future__ import annotations
import argparse,json,re,subprocess
from pathlib import Path
from urllib.parse import quote
import yaml
from jsonschema import Draft202012Validator
from jsonschema.exceptions import SchemaError

MAX_PAGES=100; MAX_ITEMS=10_000
REPO_RE=re.compile(r"(?a)^(?P<o>[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38})/(?P<n>[A-Za-z0-9_](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9_-])?)$")
SHA_RE=re.compile(r"^[0-9a-f]{40}$")
LOGIN_RE=re.compile(r"(?a)^(?=.{1,39}$)[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$")
LABELS={"type:intake","type:candidate","type:engineering","state:new","state:triaged","state:investigating","state:closed","state:draft","state:gate-failed","state:gate-passed","state:promoted","state:contracted","state:ready","state:in-progress","state:done","state:cancelled","governance:stale","governance:transition-paused","milestone:review"}
CONCLUSIONS={"success","failure","neutral","cancelled","skipped","timed_out","action_required","stale","startup_failure"}
TEMPLATE_REPOSITORY="janssenkm/GithubBootstrap"
def command_timeout():
 try:value=int(__import__("os").environ.get("ROLLOUT_VALIDATOR_TIMEOUT_SECONDS","15"))
 except ValueError:value=15
 return max(1,min(value,60))
def posid(v): return isinstance(v,int) and not isinstance(v,bool) and v>0
def safe_text(v): return isinstance(v,str) and bool(v) and not any(c in v for c in "\r\n\0")

class Report:
 def __init__(self,repo): self.v={"blocked":[],"findings":[],"observed":{"repository":repo},"schema_version":1,"unknown":[]}
 def add(self,sec,i,msg):
  x={"id":i,"message":msg}
  if x not in self.v[sec]: self.v[sec].append(x)
 def emit(self):
  for k in ("blocked","findings","unknown"): self.v[k].sort(key=lambda x:(x["id"],x["message"]))
  print(json.dumps(self.v,sort_keys=True,separators=(",",":")))

class Parser(argparse.ArgumentParser):
 def error(self,message):
  r=Report("");r.add("blocked","CLI-USAGE","invalid command-line arguments");r.emit();raise SystemExit(2)

class GH:
 def __init__(self,repo,r): self.pre=f"repos/{repo}"; self.r=r; self.failed=False
 def block(self,i,m): self.failed=True; self.r.add("blocked",i,m)
 def get(self,s):
  target=s.split("?",1)[0] or "/"
  try:p=subprocess.run(["gh","api","--method","GET",self.pre+s],text=True,capture_output=True,check=False,timeout=command_timeout())
  except subprocess.TimeoutExpired:self.block("API-TIMEOUT",f"GitHub API read timed out for {target}");return None
  except OSError:self.block("API-TOOL-UNAVAILABLE",f"GitHub API tool is unavailable for {target}");return None
  if p.returncode: self.block("API-READ-FAILED",f"GitHub API read failed for {target}"); return None
  try: return json.loads(p.stdout)
  except (json.JSONDecodeError,TypeError): self.block("API-MALFORMED",f"GitHub API returned malformed JSON for {target}"); return None
 def pages(self,s,key,valid,identity):
  out=[]; sigs=set(); ids=set()
  for page in range(1,MAX_PAGES+1):
   data=self.get(f"{s}{'&' if '?' in s else '?'}per_page=100&page={page}")
   if data is None:return None
   if key is not None:
    if not isinstance(data,dict) or not isinstance(data.get(key),list):self.block("API-MALFORMED",f"GitHub API collection shape is invalid for {s}");return None
    if set(data)&{"next","next_page","cursor","endCursor","hasNextPage"}:self.block("API-PAGINATION-CURSOR",f"GitHub API returned an unsupported pagination cursor for {s}");return None
    items=data[key]
   else:items=data
   if not isinstance(items,list):self.block("API-MALFORMED",f"GitHub API collection is not a list for {s}");return None
   if not items:return out
   sig=json.dumps(items,sort_keys=True,separators=(",",":"))
   if sig in sigs:self.block("API-PAGINATION-CYCLE",f"GitHub API repeated a page for {s}");return None
   sigs.add(sig)
   for item in items:
    if not valid(item):self.block("API-MALFORMED",f"GitHub API collection member is invalid for {s}");return None
    i=identity(item)
    if i in ids:self.block("API-DUPLICATE-ENTITY",f"GitHub API repeated an entity for {s}");return None
    ids.add(i)
   out+=items
   if len(out)>MAX_ITEMS:self.block("API-PAGINATION-LIMIT",f"GitHub API exceeded the item limit for {s}");return None
  self.block("API-PAGINATION-LIMIT",f"GitHub API did not terminate within {MAX_PAGES} pages for {s}");return None

def git(root,*a):
 try:p=subprocess.run(["git",*a],cwd=root,text=True,capture_output=True,check=False,timeout=command_timeout());return p.returncode,p.stdout.strip()
 except subprocess.TimeoutExpired:return 124,""
 except OSError:return 127,""
def origin_repo(v):
 for p in (r"^https://github\.com/([^/]+/[^/]+?)(?:\.git)?$",r"^git@github\.com:([^/]+/[^/]+?)(?:\.git)?$",r"^ssh://git@github\.com/([^/]+/[^/]+?)(?:\.git)?$"):
  m=re.fullmatch(p,v)
  if m and REPO_RE.fullmatch(m.group(1)):return m.group(1)
 return None
def policy(root,r):
 try:
  p=yaml.safe_load((root/".github/project-policy.yml").read_text()); s=json.loads((root/".github/schemas/project-policy.schema.json").read_text()); Draft202012Validator.check_schema(s);errors=list(Draft202012Validator(s).iter_errors(p))
 except (OSError,ValueError,TypeError,yaml.YAMLError,SchemaError):r.add("blocked","LOCAL-POLICY-INVALID","project policy or schema is missing or invalid");return None
 if errors:r.add("blocked","LOCAL-POLICY-INVALID","project policy does not satisfy its JSON schema");return None
 for k in ("trusted_issue_authors","trusted_developers","trusted_reviewers","trusted_milestone_acceptors"):
  v=p[k]
  if any(not isinstance(x,str) or not LOGIN_RE.fullmatch(x) for x in v) or len({x.casefold() for x in v})!=len(v):r.add("blocked","LOCAL-POLICY-INVALID",f"{k} contains invalid or duplicate logins");return None
 c=p["required_milestone_checks"]
 if not c or any(not isinstance(x,str) or not x.strip() for x in c) or len(set(c))!=len(c):r.add("blocked","LOCAL-POLICY-INVALID","required milestone checks must be unique nonempty strings");return None
 return p

def main():
 ap=Parser(description=__doc__);ap.add_argument("--repository",required=True);ap.add_argument("--root",default=".");a=ap.parse_args()
 if not REPO_RE.fullmatch(a.repository):ap.error("--repository must be a strict ASCII GitHub owner/repository")
 root=Path(a.root).resolve();r=Report(a.repository);pol=policy(root,r)
 hrc,head=git(root,"rev-parse","HEAD");orc,ourl=git(root,"remote","get-url","origin");drc,dirty=git(root,"status","--porcelain=v1","--untracked-files=all");origin=origin_repo(ourl) if not orc else None
 if 124 in {hrc,orc,drc}:r.add("blocked","LOCAL-GIT-TIMEOUT","a read-only Git command timed out")
 if hrc or not SHA_RE.fullmatch(head):r.add("blocked","LOCAL-GIT-INVALID","local HEAD could not be resolved")
 if drc or dirty:r.add("blocked","LOCAL-WORKTREE-DIRTY","local worktree has staged, unstaged, or untracked changes")
 if origin is None:r.add("blocked","LOCAL-ORIGIN-INVALID","origin is missing or is not a strict GitHub repository URL")
 elif origin!=a.repository:r.add("findings","LOCAL-ORIGIN-MISMATCH","local origin does not exactly match requested repository")
 localwf=sorted(x.name for x in (root/".github/workflows").glob("*.yml"))
 if not localwf:r.add("blocked","LOCAL-WORKFLOWS-INVALID","local workflow inventory is missing")
 r.v["observed"]["local"]={"clean":not bool(dirty),"head_sha":head if SHA_RE.fullmatch(head) else None,"origin_repository":origin,"workflow_count":len(localwf)}
 if pol:r.v["observed"]["policy"]={"rollout_mode":pol["rollout_mode"]}
 gh=GH(a.repository,r);repo=gh.get("")
 if not isinstance(repo,dict) or not posid(repo.get("id")) or repo.get("full_name")!=a.repository or not isinstance(repo.get("default_branch"),str) or not isinstance(repo.get("is_template"),bool):gh.block("API-MALFORMED","GitHub repository response has invalid required fields");repo={}
 branch=repo.get("default_branch")
 if not isinstance(branch,str) or not branch or any(x in branch for x in "\r\n?\0"):gh.block("REMOTE-DEFAULT-BRANCH-INVALID","remote default branch is missing or invalid");branch=None
 templ=repo.get("is_template") if isinstance(repo.get("is_template"),bool) else None
 canonical_identity=a.repository==TEMPLATE_REPOSITORY and origin==TEMPLATE_REPOSITORY and templ is True
 scenario="template-source" if canonical_identity else "generated-project"
 r.v["observed"]["remote"]={"default_branch":branch,"is_template":templ,"scenario":scenario}
 if a.repository==TEMPLATE_REPOSITORY and not canonical_identity:r.add("findings","TEMPLATE-IDENTITY-MISMATCH","known template identity requires exact remote name, matching origin, and template flag")
 if templ is True and a.repository!=TEMPLATE_REPOSITORY:r.add("findings","TEMPLATE-IDENTITY-MISMATCH","noncanonical repository template flag does not grant template-source policy exemptions")
 if pol and scenario=="generated-project":
  empty=[k for k in ("trusted_issue_authors","trusted_developers","trusted_reviewers","trusted_milestone_acceptors") if not pol[k]]
  if empty:r.add("blocked","TRUST-LISTS-EMPTY","generated project has empty trust lists: "+", ".join(empty))
 sha=None
 if branch:
  b=gh.get(f"/branches/{quote(branch,safe='')}")
  if not isinstance(b,dict) or b.get("name")!=branch or not isinstance(b.get("commit"),dict) or not SHA_RE.fullmatch(str(b["commit"].get("sha",""))):
   gh.block("REMOTE-DEFAULT-SHA-INVALID","remote default branch SHA is missing or invalid")
  else:sha=b["commit"]["sha"]
 r.v["observed"]["remote"]["default_sha"]=sha
 if sha is None:r.add("blocked","CHECK-EVIDENCE-UNAVAILABLE","check and workflow-run evidence cannot be bound without the remote default SHA")
 if sha and SHA_RE.fullmatch(head) and sha!=head:
  rarc,_=git(root,"merge-base","--is-ancestor",sha,head);larc,_=git(root,"merge-base","--is-ancestor",head,sha)
  ident="REMOTE-DEFAULT-BEHIND-LOCAL" if rarc==0 else ("LOCAL-BEHIND-REMOTE" if larc==0 else "LOCAL-REMOTE-DIVERGED")
  r.add("findings",ident,"remote default SHA does not equal local HEAD")
 perms=gh.get("/actions/permissions");wp=gh.get("/actions/permissions/workflow")
 if not isinstance(perms,dict) or not isinstance(perms.get("enabled"),bool) or perms.get("allowed_actions") not in {"all","local_only","selected"}:gh.block("ACTIONS-PERMISSIONS-INVALID","repository Actions permissions response is invalid")
 elif not perms["enabled"]:r.add("blocked","ACTIONS-DISABLED","GitHub Actions is disabled")
 elif perms["allowed_actions"]!="all":r.add("findings","ACTIONS-PERMISSIONS-MISMATCH","allowed Actions policy differs from documented baseline")
 if not isinstance(wp,dict) or wp.get("default_workflow_permissions") not in {"read","write"} or not isinstance(wp.get("can_approve_pull_request_reviews"),bool):gh.block("ACTIONS-PERMISSIONS-INVALID","workflow token permissions response is invalid")
 elif wp["default_workflow_permissions"]!="read" or wp["can_approve_pull_request_reviews"]:r.add("findings","ACTIONS-PERMISSIONS-MISMATCH","workflow token permissions differ from baseline")
 if isinstance(perms,dict) and isinstance(wp,dict):r.v["observed"]["actions"]={"allowed_actions":perms.get("allowed_actions"),"enabled":perms.get("enabled"),"can_approve_pull_request_reviews":wp.get("can_approve_pull_request_reviews"),"default_workflow_permissions":wp.get("default_workflow_permissions")}
 def wvalid(x):
  if not isinstance(x,dict) or not posid(x.get("id")) or x.get("state") not in {"active","disabled_inactivity","disabled_manually"}:return False
  path=x.get("path")
  if isinstance(path,str) and re.fullmatch(r"\.github/workflows/[A-Za-z0-9][A-Za-z0-9._-]*\.ya?ml",path):return True
  return path=="dynamic/dependabot/dependabot-updates" and x.get("name")=="Dependabot Updates"
 rw=gh.pages("/actions/workflows","workflows",wvalid,lambda x:x["id"]);shipped_workflow_ids=set()
 if rw is not None:
  paths=[x["path"] for x in rw]
  if len(paths)!=len(set(paths)):r.add("blocked","REMOTE-WORKFLOWS-DUPLICATE","remote workflow paths are duplicated")
  active=[x for x in rw if x["state"]=="active"]
  shipped=sorted(x["path"].removeprefix(".github/workflows/") for x in active if x["path"].startswith(".github/workflows/"))
  shipped_workflow_ids={x["id"] for x in active if x["path"].startswith(".github/workflows/")}
  dynamic=sorted(x["path"] for x in active if x["path"].startswith("dynamic/"))
  r.v["observed"]["remote"]["workflow_count"]=len(shipped)
  if dynamic:r.v["observed"]["remote"]["allowlisted_dynamic_workflows"]=dynamic
  if shipped!=localwf:r.add("findings","REMOTE-WORKFLOWS-MISMATCH","active remote workflows do not match local inventory")
 lvalid=lambda x:isinstance(x,dict) and posid(x.get("id")) and safe_text(x.get("name"))
 labels=gh.pages("/labels",None,lvalid,lambda x:x["id"])
 if labels is not None:
  names=[x["name"] for x in labels]
  if len(names)!=len(set(names)):r.add("blocked","REMOTE-LABELS-DUPLICATE","remote label names are duplicated")
  missing=sorted(LABELS-set(names));r.v["observed"]["remote"]["label_count"]=len(names)
  if missing:r.add("findings","LABELS-MISSING","required rollout labels are missing: "+", ".join(missing))
 runok=lambda x:isinstance(x,dict) and posid(x.get("id")) and posid(x.get("workflow_id")) and posid(x.get("run_attempt")) and SHA_RE.fullmatch(str(x.get("head_sha",""))) and x.get("status") in {"queued","in_progress","completed","requested","waiting","pending"} and (x.get("conclusion") is None or x.get("conclusion") in CONCLUSIONS)
 named=lambda x:isinstance(x,dict) and posid(x.get("id")) and safe_text(x.get("name")) and (x.get("conclusion") is None or x.get("conclusion") in CONCLUSIONS)
 jobok=lambda x:named(x) and safe_text(x.get("html_url"))
 jobs=[];runs=gh.pages(f"/actions/runs?branch={quote(branch,safe='')}","workflow_runs",runok,lambda x:x["id"]) if branch else None
 if runs is not None and sha:
  provenance=set()
  for run in runs:
   if run.get("head_sha")!=sha or run["workflow_id"] not in shipped_workflow_ids:continue
   key=(run["workflow_id"],run["run_attempt"])
   if key in provenance:r.add("blocked","RUN-PROVENANCE-DUPLICATE","distinct workflow runs share a workflow ID and run attempt")
   provenance.add(key)
  latest={}
  for run in runs:
   if run.get("head_sha")==sha and run["status"]=="completed" and run["workflow_id"] in shipped_workflow_ids:
    key=run["workflow_id"]
    if key not in latest or run["run_attempt"]>latest[key]["run_attempt"]:latest[key]=run
  for run in latest.values():
    js=gh.pages(f"/actions/runs/{run['id']}/jobs","jobs",jobok,lambda x:x["id"])
    if js is not None:
     seen=set()
     for job in js:
      if job["name"] in seen:r.add("blocked","JOB-NAMES-DUPLICATE","workflow job names repeat within one run")
      expected=f"https://github.com/{a.repository}/actions/runs/{run['id']}/job/{job['id']}"
      if job["html_url"]!=expected:r.add("blocked","JOB-PROVENANCE-INVALID","workflow job URL does not match its repository, run, and job IDs")
      seen.add(job["name"]);job["_workflow_id"]=run["workflow_id"];job["_run_id"]=run["id"];job["_run_attempt"]=run["run_attempt"];job["_head_sha"]=run["head_sha"]
     jobs+=js
 if len([x["id"] for x in jobs])!=len({x["id"] for x in jobs}):r.add("blocked","JOB-IDS-DUPLICATE","workflow job IDs repeat across runs")
 def checkok(x):
  return (isinstance(x,dict) and posid(x.get("id")) and safe_text(x.get("name")) and
   x.get("status") in {"queued","in_progress","completed","requested","waiting","pending"} and
   (x.get("conclusion") is None or x.get("conclusion") in CONCLUSIONS) and x.get("head_sha")==sha and
   safe_text(x.get("details_url")) and isinstance(x.get("app"),dict) and posid(x["app"].get("id")) and
   safe_text(x["app"].get("slug")) and isinstance(x.get("check_suite"),dict) and posid(x["check_suite"].get("id")))
 checks=gh.pages(f"/commits/{sha}/check-runs?filter=latest","check_runs",checkok,lambda x:x["id"]) if sha else None
 required=set(pol["required_milestone_checks"]) if pol else set()
 rsok=lambda x:isinstance(x,dict) and posid(x.get("id")) and safe_text(x.get("name")) and x.get("enforcement") in {"active","evaluate","disabled"}
 rulesets=gh.pages("/rulesets",None,rsok,lambda x:x["id"]);app=[];required_specs=[]
 if rulesets is not None:
  for summary in rulesets:
   if summary["enforcement"]!="active":continue
   d=gh.get(f"/rulesets/{summary['id']}")
   if not isinstance(d,dict) or d.get("id")!=summary["id"] or d.get("name")!=summary["name"] or d.get("enforcement")!=summary["enforcement"] or d.get("target")!="branch" or not isinstance(d.get("conditions"),dict) or not isinstance(d.get("rules"),list):gh.block("API-MALFORMED","ruleset detail response is invalid");continue
   ref=d["conditions"].get("ref_name")
   if not isinstance(ref,dict) or not isinstance(ref.get("include"),list) or not isinstance(ref.get("exclude",[]),list) or not all(safe_text(v) for v in ref["include"]+ref.get("exclude",[])):gh.block("API-MALFORMED","ruleset ref condition is invalid");continue
   if "~DEFAULT_BRANCH" not in ref["include"] and (not branch or f"refs/heads/{branch}" not in ref["include"]):continue
   if "~DEFAULT_BRANCH" in ref.get("exclude",[]) or (branch and f"refs/heads/{branch}" in ref.get("exclude",[])):continue
   contexts=[];valid=True
   for rule in d["rules"]:
    if not isinstance(rule,dict) or not isinstance(rule.get("type"),str):valid=False;break
    if rule["type"]=="required_status_checks":
     params=rule.get("parameters")
     if not isinstance(params,dict):valid=False;break
     vals=params.get("required_status_checks")
     if not isinstance(vals,list) or not all(isinstance(v,dict) and safe_text(v.get("context")) and ("integration_id" not in v or posid(v["integration_id"])) for v in vals):valid=False;break
     contexts += [v["context"] for v in vals];required_specs += vals
   if not valid:gh.block("API-MALFORMED","ruleset rules are invalid");continue
   if len(contexts)!=len(set(contexts)):r.add("blocked","RULESET-CONTEXTS-DUPLICATE","an applicable ruleset contains duplicate required contexts")
   app.append(set(contexts))
  if not app:r.add("findings","RULESET-ABSENT","no active ruleset targets default branch")
  elif not all(required<=c for c in app):r.add("findings","RULESET-CHECKS-MISMATCH","an applicable ruleset does not contain all required checks")
  for n in sorted(required):
   ids={v["integration_id"] for v in required_specs if v["context"]==n and "integration_id" in v}
   if len(ids)>1:r.add("blocked","RULESET-CONTEXT-CONFLICT",f"applicable rulesets require conflicting integrations for: {n}")
 if checks is not None:
  selected_by_name={}
  for n in sorted(required):
   candidates=[x for x in checks if x["name"]==n]
   specs=[x for x in required_specs if x["context"]==n]
   integration_ids={x["integration_id"] for x in specs if "integration_id" in x}
   if integration_ids:candidates=[x for x in candidates if x["app"]["id"] in integration_ids]
   if not candidates:r.add("findings","REQUIRED-CHECK-UNOBSERVED",f"required check has not been observed: {n}")
   else:
    apps={x["app"]["id"] for x in candidates}
    if not integration_ids and len(apps)>1:r.add("blocked","REQUIRED-CHECK-AMBIGUOUS",f"required check has multiple app integrations: {n}")
    latest_suite={}
    for x in candidates:
     key=(x["app"]["id"],x["check_suite"]["id"])
     if key not in latest_suite or x["id"]>latest_suite[key]["id"]:latest_suite[key]=x
    selected=list(latest_suite.values())
    selected_by_name[n]=selected
    if any(x.get("conclusion")!="success" for x in selected):r.add("findings","REQUIRED-CHECK-NOT-SUCCESS",f"required check is not successful: {n}")
  successful=[x for x in jobs if x.get("conclusion")=="success"]
  for n in sorted(required):
   actions_checks=[x for x in selected_by_name.get(n,[]) if x["app"]["slug"]=="github-actions"]
   if not actions_checks:continue
   matched=[x for x in successful if x["name"]==n]
   if not matched:r.add("findings","REQUIRED-JOB-UNOBSERVED",f"successful workflow job has not been observed: {n}")
   elif len({x["_workflow_id"] for x in matched})>1:r.add("blocked","REQUIRED-JOB-AMBIGUOUS",f"required job name occurs in distinct workflows: {n}")
   for check in actions_checks:
    bound=[job for job in matched if check["details_url"]==job["html_url"] and job["_head_sha"]==check["head_sha"]]
    if len(bound)!=1:r.add("blocked","REQUIRED-CHECK-PROVENANCE-INVALID",f"required GitHub Actions check is not bound to one authoritative job: {n}")
 mok=lambda x:isinstance(x,dict) and posid(x.get("id")) and posid(x.get("number")) and safe_text(x.get("title")) and x.get("state") in {"open","closed"}
 ms=gh.pages("/milestones?state=all",None,mok,lambda x:x["id"])
 if ms is not None:r.v["observed"]["remote"]["milestone_count"]=len(ms)
 r.emit()
 return 5 if gh.failed or r.v["blocked"] else (1 if r.v["findings"] else 0)
if __name__=="__main__":raise SystemExit(main())
